{
    "version": 2,
    "buildCommand": "cd frontend && npm install && npx vite build",
    "outputDirectory": "frontend/dist",
    "installCommand": "cd frontend && npm install",
    "framework": null,
    "build": {
        "env": {
            "VITE_API_URL": "https://shareway-6aeu.onrender.com/api",
            "VITE_SOCKET_URL": "https://shareway-6aeu.onrender.com",
            "VITE_GOOGLE_CLIENT_ID": "804042741041-pg20gmaqr5b5g9qbr586lng2vigjvo6m.apps.googleusercontent.com"
        }
    },
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Cross-Origin-Opener-Policy",
                    "value": "unsafe-none"
                },
                {
                    "key": "Cross-Origin-Embedder-Policy",
                    "value": "unsafe-none"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}